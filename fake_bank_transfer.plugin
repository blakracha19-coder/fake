    body.theme-dark .tbank2-close { background: #23252c; }
    body.theme-dark .tbank-action-btn,
    body.theme-dark .tbank2-action-btn {
      background: #1c1e24;
      color: #9ba3b0;
    }
    body.theme-dark .tbank-card {
      background: #1c1e24;
      box-shadow: none;
    }

    /* ================= 3B: КВИТАНЦИЯ Т-БАНК (1) ================= */
    #tbank-receipt-screen {
      background-color: #ffffff;
      color: #191c1f;
      flex: 1;
      flex-direction: column;
      padding: 28px 24px 32px;
    }

    .tbr-shield-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 32px;
      flex-shrink: 0;
      animation: popIn 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .tbr-date {
      font-size: 14.5px;
      color: #8c939b;
      margin-bottom: 8px;
      font-weight: 400;
    }

    .tbr-total-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 22px;
    }

    .tbr-total-label {
      font-size: 26px;
      font-weight: 700;
      color: #191c1f;
      letter-spacing: -0.3px;
    }

    .tbr-total-val {
      font-size: 26px;
      font-weight: 700;
      color: #191c1f;
      letter-spacing: -0.3px;
    }

    .tbr-yellow-line {
      height: 2px;
      background-color: #ffdd2d;
      width: 100%;
      margin-bottom: 24px;
      flex-shrink: 0;
    }

    .tbr-rows {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 26px;
    }

    .tbr-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
    }

    .tbr-key {
      font-size: 15.5px;
      color: #4d5359;
      flex-shrink: 0;
    }

    .tbr-val {
      font-size: 15.5px;
      color: #191c1f;
      text-align: right;
      line-height: 1.38;
      font-weight: 400;
    }

    .tbr-stamp-area {
      position: relative;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      padding-right: 4px;
      margin: 8px 0 28px;
      min-height: 98px;
    }

    .tbr-stamp-box {
      border: 1.8px solid #1862ab;
      padding: 9px 14px;
      text-align: center;
      color: #1862ab;
      width: 248px;
      background: rgba(255, 255, 255, 0.9);
      position: relative;
    }

    .tbr-stamp-title {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3px;
      margin-bottom: 4px;
    }

    .tbr-stamp-line {
      font-size: 10.5px;
      font-weight: 700;
      line-height: 1.32;
    }

    .tbr-signature-svg {
      position: absolute;
      right: 175px;
      bottom: 4px;
      width: 145px;
      height: 62px;
      pointer-events: none;
    }

    .tbr-footer {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 2px;
    }

    .tbr-receipt-num {
      font-size: 15px;
      color: #3a3f45;
    }

    .tbr-footer-note {
      font-size: 14.5px;
      color: #8c939b;
      line-height: 1.35;
    }

    .tbr-support {
      font-size: 14.5px;
      color: #707780;
    }

    /* Тёмная тема для квитанции Т-Банка */
    body.theme-dark #tbank-receipt-screen {
      background-color: #141518;
      color: #f3f4f6;
    }
    body.theme-dark .tbr-total-label,
    body.theme-dark .tbr-total-val,
    body.theme-dark .tbr-val {
      color: #f3f4f6;
    }
    body.theme-dark .tbr-key,
    body.theme-dark .tbr-receipt-num {
      color: #adb3bc;
    }
    body.theme-dark .tbr-stamp-box {
      background: rgba(20, 21, 24, 0.85);
      border-color: #4d94db;
      color: #4d94db;
    }

    /* ================= 5: ОЗОН БАНК ================= */
    #ozon-screen {
      background-color: #0f1115;
      color: #ffffff;
      flex: 1;
      flex-direction: column;
      gap: 10px;
    }

    .ozon-card-top {
      background: #181b20;
      border-radius: 0 0 22px 22px;
      padding: 40px 20px 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
    }

    .ozon-check-wrap {
      position: relative;
      width: 78px;
      height: 78px;
      border-radius: 50%;
      background: #1e2633;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 22px;
      flex-shrink: 0;
      animation: popIn 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .ozon-badge {
      position: absolute;
      top: -10px;
      right: -12px;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #005bff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      font-weight: 800;
      line-height: 1.05;
      color: #fff;
      text-align: center;
    }

    .ozon-title {
      font-size: 19px;
      font-weight: 700;
      margin-bottom: 8px;
      animation: fadeSlideUp 0.35s ease;
    }

    .ozon-subtitle {
      font-size: 15px;
      color: #8c939e;
      margin-bottom: 20px;
      text-align: center;
      animation: fadeSlideUp 0.38s ease;
    }

    .ozon-amount {
      font-size: 33px;
      font-weight: 800;
      text-align: center;
      animation: fadeSlideUp 0.4s ease;
    }

    .ozon-card-mid {
      background: #181b20;
      border-radius: 22px;
      padding: 10px 20px;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      animation: sheetUp 0.38s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .ozon-menu-item {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px 0;
      font-size: 16px;
      color: #f0f2f5;
    }

    .ozon-card-bottom {
      background: #181b20;
      border-radius: 22px 22px 0 0;
      padding: 24px 20px 28px;
      flex: 1;
      display: flex;
      flex-direction: column;
      animation: sheetUp 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .ozon-section-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .ozon-field { margin-bottom: 18px; }

    .ozon-field-label {
      font-size: 13px;
      color: #8c939e;
      margin-bottom: 4px;
    }

    .ozon-field-value {
      font-size: 16px;
      color: #ffffff;
    }

    .ozon-main-btn {
      margin-top: auto;
      background: #3382ff;
      color: #ffffff;
      border: none;
      border-radius: 16px;
      height: 52px;
      font-size: 16px;
      font-weight: 600;
      width: 100%;
      flex-shrink: 0;
    }

    body.theme-light #ozon-screen { background-color: #f0f2f5; color: #001a34; }
    body.theme-light .ozon-card-top,
    body.theme-light .ozon-card-mid,
    body.theme-light .ozon-card-bottom { background: #ffffff; }
    body.theme-light .ozon-check-wrap { background: #e8f1ff; }
    body.theme-light .ozon-menu-item { color: #001a34; }
    body.theme-light .ozon-field-value { color: #001a34; }

    /* ================= 6: ОЗОН БАНК (2) ================= */
    #ozon2-screen {
      background-color: #08192e;
      background-image:
        radial-gradient(circle at 46% 24%, rgba(44, 150, 96, 0.72) 0%, rgba(20, 88, 75, 0.46) 32%, rgba(8, 25, 46, 0) 68%),
        linear-gradient(180deg, #0d2942 0%, #0b2239 48%, #08192e 100%);
      color: #ffffff;
      flex: 1;
      flex-direction: column;
      padding: 14px 16px 22px;
    }

    .ozon2-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 44px;
      padding: 0 2px;
      flex-shrink: 0;
    }

    .ozon2-topbar-title {
      font-size: 15.5px;
      font-weight: 500;
      color: #b7c7d6;
      text-align: center;
    }

    .ozon2-close-btn {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(145, 168, 188, 0.36);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .ozon2-ticket-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      margin-top: 52px;
      margin-bottom: 24px;
    }

    .ozon2-sber-box {
      position: relative;
      width: 78px;
      height: 78px;
      border-radius: 22px;
      background: #08a629;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 4;
      margin-bottom: -39px;
      flex-shrink: 0;
      animation: popIn 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .ozon2-sber-check {
      position: absolute;
      right: -5px;
      bottom: -5px;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #19b83b;
      border: 3px solid #1a1e23;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ozon2-card {
      width: 100%;
      background-color: #1a1e23;
      border-radius: 22px;
      padding: 50px 0 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      z-index: 3;
      overflow: hidden;
      animation: fadeSlideUp 0.38s ease;
    }

    .ozon2-status {
      font-size: 19px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 6px;
    }

    .ozon2-amount {
      font-size: 29px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.3px;
      margin-bottom: 18px;
    }

    .ozon2-divider-wrap {
      width: 100%;
      height: 26px;
      position: relative;
      display: flex;
      align-items: center;
      margin-bottom: 16px;
    }

    .ozon2-notch-left {
      position: absolute;
      left: -13px;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background-color: #15494b;
    }

    .ozon2-notch-right {
      position: absolute;
      right: -13px;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background-color: #103944;
    }

    .ozon2-dashed-line {
      width: 100%;
      margin: 0 20px;
      border-top: 2px dashed #344753;
    }

    .ozon2-cat-pill {
      background-color: #25292e;
      border-radius: 18px;
      padding: 7px 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 18px;
    }

    .ozon2-cat-ruble {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background-color: #2994ff;
      color: #1a1e23;
      font-size: 11px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .ozon2-cat-text {
      font-size: 15px;
      font-weight: 500;
      color: #ffffff;
    }

    .ozon2-bank-label {
      font-size: 15px;
      color: #8a9199;
      margin-bottom: 8px;
    }

    .ozon2-recipient {
      font-size: 17px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 10px;
      text-align: center;
      padding: 0 16px;
    }

    .ozon2-phone {
      font-size: 17px;
      font-weight: 700;
      color: #ffffff;
      text-align: center;
    }

    .ozon2-promo-card {
      width: 100%;
      background-color: #2b3748;
      border-radius: 0 0 22px 22px;
      margin-top: -20px;
      padding: 36px 18px 16px;
      display: flex;
      align-items: center;
      gap: 14px;
      position: relative;
      z-index: 2;
      animation: sheetUp 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .ozon2-promo-icon {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #ffffff 0%, #b8c6db 55%, #7c65a9 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 900;
      color: #2b3748;
      flex-shrink: 0;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    }

    .ozon2-promo-text {
      flex: 1;
      font-size: 15px;
      line-height: 1.32;
      color: #ffffff;
    }

    .ozon2-actions-row {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      width: calc(100% + 16px);
      margin-right: -16px;
      padding-left: 8px;
      overflow: hidden;
      margin-bottom: 24px;
      animation: fadeSlideUp 0.44s ease;
    }

    .ozon2-action-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 72px;
      flex-shrink: 0;
    }

    .ozon2-action-box {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background-color: #121c26;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 8px;
    }

    .ozon2-action-label {
      font-size: 12px;
      color: #dbe4ed;
      white-space: nowrap;
      text-align: center;
    }

    .ozon2-done-btn {
      margin-top: auto;
      width: 100%;
      height: 54px;
      border-radius: 16px;
      background-color: #005bff;
      color: #ffffff;
      border: none;
      font-size: 17px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    body.theme-light #ozon2-screen {
      background-color: #eef2f7;
      background-image: radial-gradient(circle at 46% 24%, rgba(44, 180, 106, 0.22) 0%, rgba(238, 242, 247, 0) 65%);
      color: #141416;
    }
    body.theme-light .ozon2-topbar-title { color: #4a5568; }
    body.theme-light .ozon2-card { background-color: #ffffff; box-shadow: 0 4px 18px rgba(0,0,0,0.05); }
    body.theme-light .ozon2-sber-check { border-color: #ffffff; }
    body.theme-light .ozon2-status,
    body.theme-light .ozon2-amount,
    body.theme-light .ozon2-recipient,
    body.theme-light .ozon2-phone,
    body.theme-light .ozon2-cat-text { color: #141416; }
    body.theme-light .ozon2-cat-pill { background-color: #f0f2f5; }
    body.theme-light .ozon2-cat-ruble { color: #ffffff; }
    body.theme-light .ozon2-notch-left,
    body.theme-light .ozon2-notch-right { background-color: #e4f0ec; }
    body.theme-light .ozon2-dashed-line { border-top-color: #d0d7de; }
    body.theme-light .ozon2-promo-card { background-color: #dce4f0; }
    body.theme-light .ozon2-promo-text { color: #141416; }
    body.theme-light .ozon2-action-box { background-color: #ffffff; }
    body.theme-light .ozon2-action-label { color: #2c3748; }

    /* ================= 7: МОНОБАНК ================= */
    #mono-screen {
      background-color: #18171c;
      color: #ffffff;
      flex: 1;
      flex-direction: column;
    }

    .mono-banner {
      background-color: #4e47a6;
      height: 82px;
      width: 100%;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }

    .mono-pattern {
      width: 100%;
      height: 100%;
      opacity: 0.22;
    }

    .mono-top-section {
      background-color: #232325;
      border-radius: 22px 22px 0 0;
      margin-top: -18px;
      padding: 0 20px 34px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      z-index: 2;
      border-bottom: 1px solid #2d2d30;
      flex-shrink: 0;
    }

    .mono-avatar {
      width: 78px;
      height: 78px;
      border-radius: 50%;
      background-color: #3f3897;
      margin-top: -39px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      animation: popIn 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mono-card-num {
      font-size: 17px;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: 0.3px;
      margin-bottom: 14px;
      animation: fadeSlideUp 0.35s ease;
    }

    .mono-pill {
      background-color: #423b9d;
      border-radius: 20px;
      padding: 7px 16px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 500;
      color: #ffffff;
      margin-bottom: 18px;
      animation: fadeSlideUp 0.38s ease;
    }

    .mono-date {
      font-size: 14px;
      color: #9b9b9e;
      margin-bottom: 18px;
      animation: fadeSlideUp 0.4s ease;
    }

    .mono-amount {
      font-size: 42px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.5px;
      animation: fadeSlideUp 0.42s ease;
    }

    .mono-bottom-section {
      padding: 20px 18px 30px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      flex: 1;
      animation: sheetUp 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mono-invite-card {
      background:
        linear-gradient(#242426, #242426) padding-box,
        linear-gradient(90deg, #8b3fd9 0%, #e02b70 100%) border-box;
      border: 2px solid transparent;
      border-radius: 16px;
      padding: 20px 18px 22px;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .mono-invite-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f03276 0%, #c81e68 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      margin-bottom: 16px;
      flex-shrink: 0;
    }

    .mono-invite-text {
      font-size: 17px;
      line-height: 1.35;
      color: #ffffff;
      font-weight: 400;
    }

    .mono-row-card {
      background-color: #242426;
      border-radius: 16px;
      padding: 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    .mono-tags-text {
      font-size: 15px;
      color: #9b9b9e;
    }

    .mono-wallet-icon {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background-color: #4942a4;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .mono-balance-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .mono-balance-label {
      font-size: 14px;
      color: #9b9b9e;
    }

    .mono-balance-val {
      font-size: 16px;
      font-weight: 500;
      color: #ffffff;
    }

    body.theme-light #mono-screen { background-color: #f2f3f7; color: #18171c; }
    body.theme-light .mono-top-section { background-color: #ffffff; border-bottom-color: #e6e6eb; }
    body.theme-light .mono-card-num,
    body.theme-light .mono-amount,
    body.theme-light .mono-invite-text,
    body.theme-light .mono-balance-val { color: #18171c; }
    body.theme-light .mono-invite-card {
      background:
        linear-gradient(#ffffff, #ffffff) padding-box,
        linear-gradient(90deg, #8b3fd9 0%, #e02b70 100%) border-box;
    }
    body.theme-light .mono-row-card { background-color: #ffffff; }

    /* ================= 8: TELEGRAM WALLET ================= */
    #wallet-screen {
      background-color: #000000;
      color: #ffffff;
      flex: 1;
      flex-direction: column;
      padding: 0 14px 30px;
    }

    .wallet-topbar {
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 4px;
      margin-bottom: 8px;
      flex-shrink: 0;
    }

    .wallet-topbar-left {
      display: flex;
      align-items: center;
      gap: 20px;
      min-width: 0;
    }

    .wallet-topbar-title-wrap {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
    }

    .wallet-topbar-title {
      font-size: 19px;
      font-weight: 600;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .wallet-topbar-right {
      display: flex;
      align-items: center;
      gap: 22px;
      flex-shrink: 0;
    }

    .wallet-card {
      background-color: #1c1c1e;
      border-radius: 16px;
      padding: 20px 18px;
      margin-bottom: 14px;
      flex-shrink: 0;
      animation: fadeSlideUp 0.35s ease;
    }

    .wallet-card-details {
      background-color: #1c1c1e;
      border-radius: 16px;
      padding: 20px 18px 22px;
      flex-shrink: 0;
      animation: sheetUp 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .wallet-sent-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .wallet-up-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(180deg, #5ec2f7 0%, #3b96e6 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .wallet-sent-title {
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
    }

    .wallet-amount-row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }

    .wallet-amount-val {
      font-size: 36px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
    }

    .wallet-amount-token {
      font-size: 24px;
      font-weight: 700;
      color: #7d7d82;
      text-transform: uppercase;
    }

    .wallet-date {
      font-size: 15px;
      color: #7d7d82;
    }

    .wallet-details-header {
      font-size: 16px;
      font-weight: 600;
      color: #4ea4f5;
      margin-bottom: 18px;
    }

    .wallet-field {
      margin-bottom: 18px;
    }

    .wallet-field-label {
      font-size: 14px;
      color: #7d7d82;
      margin-bottom: 4px;
    }

    .wallet-field-val {
      font-size: 16px;
      color: #ffffff;
    }

    .wallet-address-val {
      font-family: "Roboto Mono", "SF Mono", monospace;
      font-size: 15.5px;
      line-height: 1.38;
      color: #ffffff;
      word-break: break-all;
    }

    .wallet-explorer-link {
      font-size: 16px;
      color: #4ea4f5;
      margin-top: 4px;
    }

    body.theme-light #wallet-screen { background-color: #f2f2f7; color: #000000; }
    body.theme-light .wallet-topbar-title,
    body.theme-light .wallet-sent-title,
    body.theme-light .wallet-amount-val,
    body.theme-light .wallet-field-val,
    body.theme-light .wallet-address-val { color: #000000; }
    body.theme-light .wallet-card,
    body.theme-light .wallet-card-details { background-color: #ffffff; }
    body.theme-light .wallet-icon-stroke { stroke: #000000; }
    body.theme-light .wallet-icon-fill { fill: #000000; }

    /* ================= 9: ПРИОРБАНК (PRIOR ONLINE) ================= */
    #prior-screen {
      background-color: #18191c;
      color: #ffffff;
      flex: 1;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px 20px 24px;
      box-sizing: border-box;
    }

    .prior-topbar {
      height: 44px;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .prior-title {
      font-size: 20px;
      font-weight: 600;
      color: #f1f2f4;
      letter-spacing: -0.2px;
    }

    .prior-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin: auto 0;
    }

    .prior-icon-wrap {
      width: 148px;
      height: 148px;
      border-radius: 50%;
      background: rgba(46, 174, 78, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 34px;
      flex-shrink: 0;
      animation: popIn 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .prior-icon-inner {
      width: 114px;
      height: 114px;
      border-radius: 50%;
      background: #2eae4e;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(46, 174, 78, 0.28);
    }

    .prior-desc {
      font-size: 17px;
      line-height: 1.35;
      color: #a4a7ae;
      margin-bottom: 10px;
      font-weight: 400;
      max-width: 330px;
      animation: fadeSlideUp 0.35s ease;
    }

    .prior-amount {
      font-size: 26px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.2px;
      animation: fadeSlideUp 0.4s ease;
    }

    .prior-bottom {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      flex-shrink: 0;
      animation: sheetUp 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .prior-btn-receipt {
      width: 100%;
      height: 52px;
      background-color: #fec32d;
      color: #141416;
      border: none;
      border-radius: 26px;
      font-size: 16.5px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .prior-btn-close {
      width: 100%;
      height: 48px;
      background: transparent;
      color: #ffffff;
      border: none;
      font-size: 16.5px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    body.theme-light #prior-screen {
      background-color: #f7f8fa;
      color: #16181b;
    }
    body.theme-light .prior-title {
      color: #16181b;
    }
    body.theme-light .prior-desc {
      color: #6a6f7a;
    }
    body.theme-light .prior-amount {
      color: #16181b;
    }
    body.theme-light .prior-btn-close {
      color: #16181b;
    }
  </style>
</head>
<body class="__THEME_CLASS__">

  <div class="app">

    <!-- ЭКРАН 1: СБЕР -->
    <div id="sber-screen" class="__SBER_ACTIVE__">
      <div class="sber-top">
        <div class="sber-icon-wrap">
          <div class="sber-icon-mid">
            <div class="sber-icon-inner">
              <svg width="30" height="22" viewBox="0 0 30 22" fill="none">
                <path d="M2.5 11.5L10.5 19.5L27.5 2.5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>

        <div class="sber-amount">__AMOUNT__ ₽</div>
        <div class="sber-status">Перевод выполнен</div>

        <div class="sber-actions">
          <div class="sber-action-card">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" style="flex-shrink: 0;">
              <path d="M20 11A8.1 8.1 0 0 0 4.5 9M4 5v4h4M4 13a8.1 8.1 0 0 0 15.5 2" stroke="#21a038" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
