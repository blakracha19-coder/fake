class FakeBankTransferPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            self.add_settings_menu_item(
                text="Fake Bank Transfer",
                icon="msg_payment_card",
                on_click=self._on_main_menu_click
            )
        except AttributeError:
            try:
                from base_plugin import MenuItemType
                self.add_menu_item(
                    MenuItemType.SETTINGS,
                    text="Fake Bank Transfer",
                    icon="msg_payment_card",
                    on_click=self._on_main_menu_click
                )
            except Exception:
                pass

    def on_plugin_unload(self):
        pass

    def _on_main_menu_click(self, *args):
        try:
            self.open_plugin_settings()
        except Exception:
            pass

    def create_settings(self):
        if not self.get_setting("amount", ""):
            self._randomize_requisites()

        bank_type = int(self.get_setting("bank_type", 0))
        if bank_type == 6:
            currency_symbol = "₴"
        elif bank_type == 7:
            currency_symbol = str(self.get_setting("wallet_token", "GRAM")).strip() or "GRAM"
        elif bank_type == 8:
            currency_symbol = str(self.get_setting("prior_currency", "BYN")).strip() or "BYN"
        else:
            currency_symbol = "₽"

        settings_list = [
            Header(text="Выбор банка и темы"),
            Selector(
                key="bank_type",
                text="Банк",
                default=0,
                items=[
                    "1: 🇷🇺 Сбер",
                    "2: 🇷🇺 Альфа-Банк",
                    "3: 🇷🇺 Т-Банк",
                    "4: 🇷🇺 Т-Банк (2)",
                    "5: 🇷🇺 Озон-Банк",
                    "6: 🇷🇺 Озон-Банк (2)",
                    "7: 🇺🇦 Монобанк",
                    "8: Telegram Wallet",
                    "9: 🇧🇾 Приорбанк"
                ],
                on_change=self.on_bank_change
            ),
            Selector(
                key="theme_mode",
                text="Тема чека",
                default=0,
                items=["По умолчанию", "Тёмная", "Светлая"]
            ),
            Divider(),
            Header(text="Настройки выбранного банка"),
            Input(
                key="amount",
                text=f"Сумма перевода ({currency_symbol})",
                default=str(self.get_setting("amount", "")),
                on_change=self.on_amount_change
            )
        ]

        if bank_type == 0:
            settings_list.append(
                Input(
                    key="sber_card",
                    text="Номер карты получателя (последние 4 цифры)",
                    default="7447"
                )
            )
        elif bank_type == 1:
            settings_list.extend([
                Input(
                    key="alfa_account",
                    text="Счёт списания (последние 4 цифры)",
                    default="9477"
                ),
                Input(
                    key="alfa_recipient",
                    text="Имя получателя",
                    default="Нэсп без идентификации Д."
                ),
                Input(
                    key="alfa_bank_name",
                    text="Банк получателя",
                    default="Озон Банк (Ozon)"
                ),
                Input(
                    key="alfa_phone",
                    text="Номер телефона получателя",
                    default="+7 (963) 444-00-39"
                ),
                Input(
                    key="alfa_fee_text",
                    text="Текст комиссии",
                    default="Без комиссии"
                )
            ])
        elif bank_type == 2:
            tbank_mode = int(self.get_setting("tbank_mode", 0))
            settings_list.extend([
                Selector(
                    key="tbank_mode",
                    text="Тип экрана",
                    default=0,
                    items=["Экран операции", "Квитанция (Официальный чек)"],
                    on_change=self.on_tbank_mode_change
                ),
                Input(
                    key="recipient",
                    text="Имя получателя",
                    default="Тимур Г."
                ),
                Input(
                    key="tbank_card",
                    text="Номер карты получателя",
                    default="220039******7525"
                )
            ])

            if tbank_mode == 0:
                settings_list.append(
                    Input(
                        key="balance",
                        text="Остаток на карте Black (₽)",
                        default="3387,61",
                        on_change=self.on_balance_change
                    )
                )
            else:
                settings_list.extend([
                    Input(
                        key="tbank_rec_date",
                        text="Дата и время квитанции",
                        default="02.11.2026 14:16:41"
                    ),
                    Input(
                        key="tbank_rec_sender",
                        text="Отправитель",
                        default="Олег Огренич"
                    ),
                    Input(
                        key="tbank_rec_num",
                        text="Номер квитанции",
                        default="1-104-590-944-194"
                    )
                ])
        elif bank_type == 3:
            settings_list.extend([
                Input(
                    key="tbank2_date",
                    text="Дата сверху",
                    default="20 марта • 17:53"
                ),
                Input(
                    key="tbank2_recipient",
                    text="Имя получателя",
                    default="Михаил П."
                ),
                Input(
                    key="tbank2_requisites",
                    text="Реквизиты (Номер телефона)",
                    default="+7 921 142-90-11"
                )
            ])
        elif bank_type == 4:
            settings_list.append(
                Input(
                    key="fee",
                    text="Комиссия за перевод (₽)",
                    default="99",
                    on_change=self.on_fee_change
                )
            )
        elif bank_type == 5:
            settings_list.extend([
                Input(
                    key="ozon2_bank",
                    text="Банк получателя",
                    default="Сбербанк"
                ),
                Input(
                    key="ozon2_recipient",
                    text="Имя получателя",
                    default="Андрей Игоревич Л."
                ),
                Input(
                    key="ozon2_phone",
                    text="Номер телефона получателя",
                    default="+7 (951) 685-84-59"
                )
            ])
        elif bank_type == 6:
            settings_list.extend([
                Input(
                    key="mono_date",
                    text="Дата перевода",
                    default="25 листопада 2024, 13:50"
                ),
                Input(
                    key="mono_balance",
                    text="Залишок (₴)",
                    default="91.04",
                    on_change=self.on_mono_balance_change
                ),
                Input(
                    key="mono_card",
                    text="Номер карты получателя",
                    default="516874****8224"
                )
            ])
        elif bank_type == 7:
            settings_list.extend([
                Input(
                    key="wallet_token",
                    text="Валюта / Токен",
                    default="GRAM",
                    on_change=self.on_wallet_token_change
                ),
                Input(
                    key="wallet_date",
                    text="Дата перевода",
                    default="30 октября в 14:58"
                ),
                Input(
                    key="wallet_address",
                    text="Адрес получателя",
                    default="UQAM3AL6N2cpNjXKqoxzEA_L9kFJebk6yifeP3cCL8k-djsk"
                ),
                Input(
                    key="wallet_fee",
                    text="Комиссия",
                    default="0,000513009"
                )
            ])
        elif bank_type == 8:
            prior_mode = int(self.get_setting("prior_mode", 0))
            settings_list.extend([
                Selector(
                    key="prior_mode",
                    text="Тип перевода",
                    default=0,
                    items=["По номеру карты", "По номеру договора"],
                    on_change=self.on_prior_mode_change
                ),
                Input(
                    key="prior_currency",
                    text="Валюта (BYN, USD, RUB, EUR...)",
                    default=str(self.get_setting("prior_currency", "BYN")),
                    on_change=self.on_prior_currency_change
                )
            ])

            if prior_mode == 0:
                first6 = str(self.get_setting("prior_card_first6", "491698"))
                last4 = str(self.get_setting("prior_card_last4", "7710"))
                settings_list.extend([
                    Input(
                        key="prior_card_first6",
                        text="Первые 6 цифр карты",
                        default=first6,
                        on_change=self.on_prior_first6_change
                    ),
                    Input(
                        key="prior_card_last4",
                        text="Последние 4 цифры карты",
                        default=last4,
                        on_change=self.on_prior_last4_change
                    ),
                    Text(
                        text=f"Итоговая маска: {first6}******{last4}",
                        icon="msg_info"
                    )
                ])
            else:
                settings_list.append(
                    Input(
                        key="prior_contract",
                        text="Номер договора",
                        default=str(self.get_setting("prior_contract", "0980063001196"))
                    )
                )

        settings_list.extend([
            Text(
                text="Случайные настройки",
                icon="msg_retry",
                on_click=self.generate_random_data
            ),
            Divider(),
            Header(text="Генерация и сохранение"),
            Text(
                text="Открыть чек перевода",
                icon="msg_payment_card",
                accent=True,
                on_click=self.open_receipt
            ),
            Text(
                text="Сохранить чек в галерею",
                icon="msg_gallery",
                accent=True,
                on_click=self.save_receipt_to_gallery
            ),
            Divider(),
            Text(
                text="Plugin made by @morkxdddd & @flovnev",
                icon="msg_info"
            )
        ])

        return settings_list

    def on_bank_change(self, *args):
        if args and isinstance(args[0], int):
            self.set_setting("bank_type", args[0])
        self._randomize_requisites()
        run_on_ui_thread(self._refresh_settings_screen)

    def on_tbank_mode_change(self, *args):
        if args and isinstance(args[0], int):
            self.set_setting("tbank_mode", args[0])
        run_on_ui_thread(self._refresh_settings_screen)

    def on_prior_mode_change(self, *args):
        if args and isinstance(args[0], int):
            self.set_setting("prior_mode", args[0])
        run_on_ui_thread(self._refresh_settings_screen)

    def on_prior_currency_change(self, *args):
        if args and isinstance(args[0], str):
            clean_curr = "".join(ch for ch in args[0] if ch.isalnum()).upper() or "BYN"
            self.set_setting("prior_currency", clean_curr)
            run_on_ui_thread(self._refresh_settings_screen)

    def on_prior_first6_change(self, *args):
        if args and isinstance(args[0], str):
            digits = "".join(ch for ch in args[0] if ch.isdigit())[:6]
            self.set_setting("prior_card_first6", digits or "491698")
            run_on_ui_thread(self._refresh_settings_screen)

    def on_prior_last4_change(self, *args):
        if args and isinstance(args[0], str):
            digits = "".join(ch for ch in args[0] if ch.isdigit())[:4]
            self.set_setting("prior_card_last4", digits or "7710")
            run_on_ui_thread(self._refresh_settings_screen)

    def on_amount_change(self, *args):
        if args and isinstance(args[0], str):
            bank_type = int(self.get_setting("bank_type", 0))
            sep = "." if bank_type in (6, 8) else ","
            self.set_setting("amount", format_spaces(args[0], decimal_sep=sep))

    def on_fee_change(self, *args):
        if args and isinstance(args[0], str):
            self.set_setting("fee", format_spaces(args[0]))

    def on_balance_change(self, *args):
        if args and isinstance(args[0], str):
            self.set_setting("balance", format_spaces(args[0]))

    def on_mono_balance_change(self, *args):
        if args and isinstance(args[0], str):
            self.set_setting("mono_balance", format_spaces(args[0], decimal_sep="."))

    def on_wallet_token_change(self, *args):
        if args and isinstance(args[0], str):
            self.set_setting("wallet_token", args[0].strip().upper() or "GRAM")
            run_on_ui_thread(self._refresh_settings_screen)

    def _randomize_requisites(self):
        """Заполняет все настройки случайными значениями."""
        now = datetime.now()
        bank_type = int(self.get_setting("bank_type", 0))

        rand_amount = str(random.randint(10, 500)) if bank_type == 8 else str(random.randint(100, 50000))
        sep = "." if bank_type in (6, 8) else ","
        self.set_setting("amount", format_spaces(rand_amount, decimal_sep=sep))

        last4 = str(random.randint(1000, 9999))
        name = random.choice(RANDOM_NAMES)
        full_name = random.choice(RANDOM_FULL_NAMES)

        self.set_setting("sber_card", last4)
        self.set_setting("fee", random.choice(["0", "30", "45", "50", "99", "149"]))
        self.set_setting("recipient", name)

        ru_bin = random.choice(["220039", "220070", "220220", "427638", "553691"])
        self.set_setting("tbank_card", f"{ru_bin}******{last4}")
        bal_int = random.randint(450, 120000)
        bal_kop = random.randint(0, 99)
        self.set_setting("balance", format_spaces(f"{bal_int},{bal_kop:02d}"))

        # Квитанция Т-Банка (1)
        self.set_setting("tbank_rec_date", now.strftime("%d.%m.%Y %H:%M:%S"))
        self.set_setting("tbank_rec_sender", random.choice(RANDOM_SENDERS))
        r_p1 = random.randint(100, 999)
        r_p2 = random.randint(100, 999)
        r_p3 = random.randint(100, 999)
        r_p4 = random.randint(100, 999)
        self.set_setting("tbank_rec_num", f"1-{r_p1}-{r_p2}-{r_p3}-{r_p4}")

        tb_day = random.randint(1, 28)
        tb_month = random.randint(1, 12)
        tb_hour = random.randint(0, 23)
        tb_min = random.randint(0, 59)
        ru_date = f"{tb_day} {RU_MONTHS[tb_month]} • {tb_hour:02d}:{tb_min:02d}"
        self.set_setting("tbank2_date", ru_date)
        self.set_setting("tbank2_recipient", name)
        p1 = random.randint(900, 999)
        p2 = random.randint(100, 999)
        p3 = random.randint(10, 99)
        p4 = random.randint(10, 99)
        self.set_setting("tbank2_requisites", f"+7 {p1} {p2}-{p3}-{p4}")

        self.set_setting("ozon2_bank", "Сбербанк")
        self.set_setting("ozon2_recipient", full_name)
        self.set_setting("ozon2_phone", f"+7 ({p1}) {p2}-{p3:02d}-{p4:02d}")

        m_day = random.randint(1, 28)
        m_month = random.randint(1, 12)
        m_year = random.choice([now.year - 1, now.year])
        m_hour = random.randint(0, 23)
        m_min = random.randint(0, 59)
        ua_date = f"{m_day} {UA_MONTHS[m_month]} {m_year}, {m_hour:02d}:{m_min:02d}"
        self.set_setting("mono_date", ua_date)
        m_bal_int = random.randint(50, 45000)
        m_bal_kop = random.randint(0, 99)
        self.set_setting("mono_balance", format_spaces(f"{m_bal_int}.{m_bal_kop:02d}", decimal_sep="."))
        ua_bin = random.choice(["516874", "444111", "537541"])
        self.set_setting("mono_card", f"{ua_bin}****{last4}")

        w_token = random.choice(["GRAM", "USDT"])
        w_day = random.randint(1, 28)
        w_month = random.randint(1, 12)
        w_hour = random.randint(0, 23)
        w_min = random.randint(0, 59)
        chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-"
        rand_addr = "UQ" + "".join(random.choice(chars) for _ in range(46))
        self.set_setting("wallet_token", w_token)
        self.set_setting("wallet_address", rand_addr)
        self.set_setting("wallet_date", f"{w_day} {RU_MONTHS[w_month]} в {w_hour:02d}:{w_min:02d}")
        self.set_setting("wallet_fee", f"0,000{random.randint(100000, 999999)}")

        alfa_acc = str(random.randint(1000, 9999))
        self.set_setting("alfa_account", alfa_acc)
        self.set_setting("alfa_recipient", random.choice(RANDOM_NAMES + ["Нэсп без идентификации Д."]))
        self.set_setting("alfa_bank_name", "Озон Банк (Ozon)")
        self.set_setting("alfa_phone", f"+7 ({p1}) {p2}-{p3:02d}-{p4:02d}")
        self.set_setting("alfa_fee_text", "Без комиссии")

        # Приорбанк
        by_bin = "491698"
        self.set_setting("prior_currency", "BYN")
        self.set_setting("prior_card_first6", by_bin)
        self.set_setting("prior_card_last4", last4)
        self.set_setting("prior_contract", f"09800{random.randint(10000000, 99999999)}")

    def generate_random_data(self, *args):
        """Генерирует случайные настройки и обновляет экран без уведомления."""
        self._randomize_requisites()
        run_on_ui_thread(self._refresh_settings_screen)

    def _refresh_settings_screen(self):
        """Принудительно перестраивает экран настроек плагина на месте без перезахода."""
        try:
            fragment = get_last_fragment()
            if not fragment:
                return

            scroll_pos = 0
            scroll_offset = 0
            lm = None
            if hasattr(fragment, "listView") and fragment.listView:
                lm = fragment.listView.getLayoutManager()
                if lm and hasattr(lm, "findFirstVisibleItemPosition"):
                    scroll_pos = lm.findFirstVisibleItemPosition()
                    first_view = lm.findViewByPosition(scroll_pos)
                    if first_view:
                        scroll_offset = first_view.getTop()

            parent_layout = fragment.getParentLayout() if hasattr(fragment, "getParentLayout") else None
            if parent_layout and hasattr(parent_layout, "rebuildAllFragmentViews"):
                parent_layout.rebuildAllFragmentViews(True, True)
                if hasattr(fragment, "listView") and fragment.listView:
                    new_lm = fragment.listView.getLayoutManager()
                    if new_lm and hasattr(new_lm, "scrollToPositionWithOffset"):
                        new_lm.scrollToPositionWithOffset(scroll_pos, scroll_offset)
                return

            if hasattr(fragment, "listView") and fragment.listView:
                adapter = fragment.listView.getAdapter()
                if adapter:
                    if hasattr(adapter, "update"):
                        adapter.update(False)
                    if hasattr(adapter, "notifyDataSetChanged"):
                        adapter.notifyDataSetChanged()
        except Exception:
            pass

    def open_receipt(self, *args):
        run_on_ui_thread(self._show_dialog)

    def save_receipt_to_gallery(self, *args):
        run_on_ui_thread(self._save_receipt_silently)

    def _resolve_is_dark(self, bank_type: int) -> bool:
        theme_mode = int(self.get_setting("theme_mode", 0))
        if theme_mode == 1:
            return True
        if theme_mode == 2:
            return False
        # По умолчанию: квитанция Т-Банка (1) светлая, остальные по своим дефолтам
        if bank_type == 2 and int(self.get_setting("tbank_mode", 0)) == 1:
            return False
        return bank_type in (0, 1, 4, 5, 6, 7, 8)

    def _build_receipt_html_and_colors(self, no_anim: bool = False):
        if not self.get_setting("amount", ""):
            self._randomize_requisites()

        bank_type = int(self.get_setting("bank_type", 0))
        tbank_mode = int(self.get_setting("tbank_mode", 0))
        is_dark = self._resolve_is_dark(bank_type)
        theme_class = "theme-dark" if is_dark else "theme-light"
        if no_anim:
            theme_class += " no-anim"

        raw_amount = str(self.get_setting("amount", "1000"))
        amount = format_spaces(raw_amount)
        mono_amount = format_mono_amount(raw_amount)

        fee = format_spaces(self.get_setting("fee", "99"))
        recipient = str(self.get_setting("recipient", "Тимур Г.")).strip()
        balance = format_spaces(self.get_setting("balance", "3387,61"))

        tbank2_date = str(self.get_setting("tbank2_date", "20 марта • 17:53")).strip()
        tbank2_recipient = str(self.get_setting("tbank2_recipient", "Михаил П.")).strip()
        tbank2_req = str(self.get_setting("tbank2_requisites", "+7 921 142-90-11")).strip()

        ozon2_bank = str(self.get_setting("ozon2_bank", "Сбербанк")).strip()
        ozon2_recipient = str(self.get_setting("ozon2_recipient", "Андрей Игоревич Л.")).strip()
        ozon2_phone = str(self.get_setting("ozon2_phone", "+7 (951) 685-84-59")).strip()

        mono_date = str(self.get_setting("mono_date", "25 листопада 2024, 13:50")).strip()
        mono_balance = format_spaces(self.get_setting("mono_balance", "91.04"), decimal_sep=".")
        raw_mono_card = str(self.get_setting("mono_card", "516874****8224")).replace(" ", "")
        if "*" in raw_mono_card:
            mono_card = raw_mono_card
        elif len(raw_mono_card) >= 10:
            mono_card = raw_mono_card[:6] + "****" + raw_mono_card[-4:]
        elif len(raw_mono_card) >= 4:
            mono_card = "516874****" + raw_mono_card[-4:]
        else:
            mono_card = "516874****8224"

        wallet_token = str(self.get_setting("wallet_token", "GRAM")).strip() or "GRAM"
        wallet_date = str(self.get_setting("wallet_date", "30 октября в 14:58")).strip()
        wallet_full_addr = str(
            self.get_setting("wallet_address", "UQAM3AL6N2cpNjXKqoxzEA_L9kFJebk6yifeP3cCL8k-djsk")
        ).strip()
        if len(wallet_full_addr) > 10:
            wallet_short_addr = f"{wallet_full_addr[:4]}...{wallet_full_addr[-4:]}"
        else:
            wallet_short_addr = wallet_full_addr
        wallet_fee = str(self.get_setting("wallet_fee", "0,000513009")).strip()

        raw_alfa_acc = str(self.get_setting("alfa_account", "9477")).replace(" ", "")
        alfa_account = raw_alfa_acc[-4:] if len(raw_alfa_acc) >= 4 else (raw_alfa_acc or "9477")
        alfa_recipient = str(self.get_setting("alfa_recipient", "Нэсп без идентификации Д.")).strip()
        alfa_bank_name = str(self.get_setting("alfa_bank_name", "Озон Банк (Ozon)")).strip()
        alfa_phone = str(self.get_setting("alfa_phone", "+7 (963) 444-00-39")).strip()
        alfa_fee_text = str(self.get_setting("alfa_fee_text", "Без комиссии")).strip()

        raw_sber_card = str(self.get_setting("sber_card", "7447")).replace(" ", "")
        last4 = raw_sber_card[-4:] if len(raw_sber_card) >= 4 else (raw_sber_card or "7447")

        raw_tbank_card = str(self.get_setting("tbank_card", "220039******7525")).replace(" ", "")
        if "*" in raw_tbank_card:
            masked_card = raw_tbank_card
        elif len(raw_tbank_card) >= 10:
            masked_card = raw_tbank_card[:6] + "******" + raw_tbank_card[-4:]
        elif len(raw_tbank_card) >= 4:
            masked_card = "220039******" + raw_tbank_card[-4:]
        else:
            masked_card = "220039******7525"

        # Данные для квитанции Т-Банка (1)
        tbank_rec_last4, tbank_rec_spaced_card = format_tbank_receipt_card(raw_tbank_card)
        tbank_rec_date = str(self.get_setting("tbank_rec_date", "02.11.2026 14:16:41")).strip()
        tbank_rec_sender = str(self.get_setting("tbank_rec_sender", "Олег Огренич")).strip()
        tbank_rec_num = str(self.get_setting("tbank_rec_num", "1-104-590-944-194")).strip()

        # Данные Приорбанка
        prior_currency = str(self.get_setting("prior_currency", "BYN")).strip() or "BYN"
        prior_mode = int(self.get_setting("prior_mode", 0))
        if bank_type == 8:
            if prior_mode == 0:
                p_first6 = str(self.get_setting("prior_card_first6", "491698")).strip() or "491698"
                p_last4 = str(self.get_setting("prior_card_last4", "7710")).strip() or "7710"
                p_card = f"{p_first6}******{p_last4}"
                prior_desc = f"Перевод на карту {p_card}"
                prior_amount = format_mono_amount(raw_amount)
            else:
                p_contract = str(self.get_setting("prior_contract", "0980063001196")).strip()
                prior_desc = f"Пополнение карточки {p_contract}"
                prior_amount = format_spaces(raw_amount, decimal_sep=",")
                if "," not in prior_amount:
                    prior_amount = f"{prior_amount},00"
        else:
            prior_desc = ""
            prior_amount = ""

        if bank_type == 0:
            bg_hex = "#111113" if is_dark else "#f3f4f6"
            status_hex = "#111113" if is_dark else "#f3f4f6"
            nav_hex = "#1d1a22" if is_dark else "#ffffff"
        elif bank_type == 1:
            bg_hex = "#0b0b0c" if is_dark else "#f2f3f7"
            status_hex = "#0b0b0c" if is_dark else "#f2f3f7"
            nav_hex = "#0b0b0c" if is_dark else "#f2f3f7"
        elif bank_type == 2 and tbank_mode == 1:
            bg_hex = "#141518" if is_dark else "#ffffff"
            status_hex = "#141518" if is_dark else "#ffffff"
            nav_hex = "#141518" if is_dark else "#ffffff"
        elif bank_type == 4:
            bg_hex = "#0f1115" if is_dark else "#f0f2f5"
            status_hex = "#181b20" if is_dark else "#ffffff"
            nav_hex = "#181b20" if is_dark else "#ffffff"
        elif bank_type == 5:
            bg_hex = "#08192e" if is_dark else "#eef2f7"
            status_hex = "#0d2942" if is_dark else "#eef2f7"
            nav_hex = "#08192e" if is_dark else "#eef2f7"
        elif bank_type == 6:
            bg_hex = "#18171c" if is_dark else "#f2f3f7"
            status_hex = "#4e47a6"
            nav_hex = "#18171c" if is_dark else "#f2f3f7"
        elif bank_type == 7:
            bg_hex = "#000000" if is_dark else "#f2f2f7"
            status_hex = "#000000" if is_dark else "#f2f2f7"
            nav_hex = "#000000" if is_dark else "#f2f2f7"
        elif bank_type == 8:
            bg_hex = "#18191c" if is_dark else "#f7f8fa"
            status_hex = "#18191c" if is_dark else "#f7f8fa"
            nav_hex = "#18191c" if is_dark else "#f7f8fa"
        else:
            bg_hex = "#0f1012" if is_dark else "#f5f6f8"
            status_hex = "#0f1012" if is_dark else "#ffffff"
            nav_hex = "#0f1012" if is_dark else "#f5f6f8"

        bg_color = Color.parseColor(bg_hex)
        status_color = Color.parseColor(status_hex)
        nav_color = Color.parseColor(nav_hex)

        html = (
            HTML_TEMPLATE
            .replace("__BG_HEX__", bg_hex)
            .replace("__THEME_CLASS__", theme_class)
            .replace("__SBER_ACTIVE__", "active-screen" if bank_type == 0 else "")
            .replace("__ALFA_ACTIVE__", "active-screen" if bank_type == 1 else "")
            .replace("__TBANK_ACTIVE__", "active-screen" if (bank_type == 2 and tbank_mode == 0) else "")
            .replace("__TBANK_RECEIPT_ACTIVE__", "active-screen" if (bank_type == 2 and tbank_mode == 1) else "")
            .replace("__TBANK2_ACTIVE__", "active-screen" if bank_type == 3 else "")
            .replace("__OZON_ACTIVE__", "active-screen" if bank_type == 4 else "")
            .replace("__OZON2_ACTIVE__", "active-screen" if bank_type == 5 else "")
            .replace("__MONO_ACTIVE__", "active-screen" if bank_type == 6 else "")
            .replace("__WALLET_ACTIVE__", "active-screen" if bank_type == 7 else "")
            .replace("__PRIOR_ACTIVE__", "active-screen" if bank_type == 8 else "")
            .replace("__AMOUNT__", amount)
            .replace("__MONO_AMOUNT__", mono_amount)
            .replace("__LAST4__", last4)
            .replace("__MASKED_CARD__", masked_card)
            .replace("__TBANK_REC_DATE__", tbank_rec_date)
            .replace("__TBANK_REC_LAST4__", tbank_rec_last4)
            .replace("__TBANK_REC_SPACED_CARD__", tbank_rec_spaced_card)
            .replace("__TBANK_REC_SENDER__", tbank_rec_sender)
            .replace("__TBANK_REC_NUM__", tbank_rec_num)
            .replace("__FEE__", fee)
            .replace("__RECIPIENT__", recipient)
            .replace("__BALANCE__", balance)
            .replace("__TBANK2_DATE__", tbank2_date)
            .replace("__TBANK2_RECIPIENT__", tbank2_recipient)
            .replace("__TBANK2_REQ__", tbank2_req)
            .replace("__OZON2_BANK__", ozon2_bank)
            .replace("__OZON2_RECIPIENT__", ozon2_recipient)
            .replace("__OZON2_PHONE__", ozon2_phone)
            .replace("__MONO_DATE__", mono_date)
            .replace("__MONO_BALANCE__", mono_balance)
            .replace("__MONO_CARD__", mono_card)
            .replace("__WALLET_TOKEN__", wallet_token)
            .replace("__WALLET_DATE__", wallet_date)
            .replace("__WALLET_FULL_ADDR__", wallet_full_addr)
            .replace("__WALLET_SHORT_ADDR__", wallet_short_addr)
            .replace("__WALLET_FEE__", wallet_fee)
            .replace("__ALFA_ACCOUNT__", alfa_account)
            .replace("__ALFA_RECIPIENT__", alfa_recipient)
            .replace("__ALFA_BANK_NAME__", alfa_bank_name)
            .replace("__ALFA_PHONE__", alfa_phone)
            .replace("__ALFA_FEE_TEXT__", alfa_fee_text)
            .replace("__PRIOR_DESC__", prior_desc)
            .replace("__PRIOR_AMOUNT__", prior_amount)
            .replace("__PRIOR_CURRENCY__", prior_currency)
        )

        return html, bg_color, status_color, nav_color

    def _capture_webview_to_gallery(self, activity, webview):
        try:
            width = webview.getWidth()
            height = webview.getHeight()
            if width <= 0 or height <= 0:
                return

            bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
            canvas = Canvas(bitmap)
            webview.draw(canvas)

            filename = f"Receipt_{int(datetime.now().timestamp())}.png"
            values = ContentValues()
            values.put(MediaStore.Images.Media.DISPLAY_NAME, filename)
            values.put(MediaStore.Images.Media.MIME_TYPE, "image/png")
            values.put(MediaStore.Images.Media.RELATIVE_PATH, "Pictures/FakeTransfers")

            resolver = activity.getContentResolver()
            uri = resolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values)
            if uri:
                out_stream = resolver.openOutputStream(uri)
                if out_stream:
                    bitmap.compress(Bitmap.CompressFormat.PNG, 100, out_stream)
                    out_stream.flush()
                    out_stream.close()
                Toast.makeText(
                    activity,
                    "Чек сохранён в галерею (Pictures/FakeTransfers)",
                    Toast.LENGTH_SHORT
                ).show()
        except Exception as e:
            Toast.makeText(activity, f"Ошибка сохранения: {e}", Toast.LENGTH_SHORT).show()

    def _save_receipt_silently(self):
        """Рендерит и сохраняет чек в галерею в фоновом режиме без показа окна."""
        fragment = get_last_fragment()
        if not fragment:
            return
        activity = fragment.getParentActivity()
        if not activity:
            return

        try:
            WebView.enableSlowWholeDocumentDraw()
        except Exception:
            pass

        html, bg_color, _, _ = self._build_receipt_html_and_colors(no_anim=True)

        metrics = activity.getResources().getDisplayMetrics()
        width = int(metrics.widthPixels) if metrics and metrics.widthPixels > 0 else 1080
        height = int(metrics.heightPixels) if metrics and metrics.heightPixels > 0 else 2400

        webview = WebView(activity)
        webview.setBackgroundColor(bg_color)
        webview.setLayerType(View.LAYER_TYPE_SOFTWARE, None)
        ws = webview.getSettings()
        ws.setJavaScriptEnabled(False)
        ws.setDomStorageEnabled(False)

        wrapper = FrameLayout(activity)
        wrapper.setAlpha(0.0)
        wrapper.setClickable(False)
        wrapper.setFocusable(False)
        wrapper.addView(webview, FrameLayout.LayoutParams(width, height))

        decor_view = activity.getWindow().getDecorView() if activity.getWindow() else None
        attached_parent = None
        if isinstance(decor_view, ViewGroup):
            decor_view.addView(wrapper, ViewGroup.LayoutParams(width, height))
            attached_parent = decor_view

        spec_w = View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY)
        spec_h = View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY)
        webview.measure(spec_w, spec_h)
        webview.layout(0, 0, width, height)

        webview.loadDataWithBaseURL(None, html, "text/html", "UTF-8", None)

        def _finish_silent_capture():
            try:
                webview.measure(spec_w, spec_h)
                webview.layout(0, 0, width, height)
                self._capture_webview_to_gallery(activity, webview)
            finally:
                try:
                    if attached_parent is not None:
                        attached_parent.removeView(wrapper)
                    webview.destroy()
                except Exception:
                    pass

        threading.Timer(0.4, lambda: run_on_ui_thread(_finish_silent_capture)).start()

    def _show_dialog(self):
        fragment = get_last_fragment()
        if not fragment:
            return
        activity = fragment.getParentActivity()
        if not activity:
            return

        html, bg_color, status_color, nav_color = self._build_receipt_html_and_colors(no_anim=False)

        dialog = Dialog(activity, 16973834)
        window = dialog.getWindow()
        if window:
            window.requestFeature(Window.FEATURE_NO_TITLE)
            window.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
            window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS)
            window.setStatusBarColor(status_color)
            window.setNavigationBarColor(nav_color)
            window.setBackgroundDrawable(ColorDrawable(bg_color))

        webview = WebView(activity)
        webview.setBackgroundColor(bg_color)
        webview.setLayerType(View.LAYER_TYPE_SOFTWARE, None)
        ws = webview.getSettings()
        ws.setJavaScriptEnabled(False)
        ws.setDomStorageEnabled(False)

        try:
            from java import dynamic_proxy

            class LongClickSaver(dynamic_proxy(View.OnLongClickListener)):
                def __init__(self, plugin_ref, act, wv):
                    super().__init__()
                    self.plugin_ref = plugin_ref
                    self.act = act
                    self.wv = wv

                def onLongClick(self, v):
                    self.plugin_ref._capture_webview_to_gallery(self.act, self.wv)
                    return True

            webview.setOnLongClickListener(LongClickSaver(self, activity, webview))
        except Exception:
            pass

        webview.loadDataWithBaseURL(None, html, "text/html", "UTF-8", None)
        dialog.setContentView(webview)
        dialog.show()