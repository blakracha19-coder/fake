def format_spaces(val: str, decimal_sep: str = ",") -> str:
    """Автоматически расставляет пробелы между разрядами чисел."""
    s = (
        str(val)
        .strip()
        .lstrip("-")
        .lstrip("–")
        .replace("₽", "")
        .replace("₴", "")
        .replace(" ", "")
        .replace("\u00a0", "")
    )
    if not s:
        return "0"
    sep = "," if "," in s else ("." if "." in s else None)
    if sep:
        parts = s.split(sep, 1)
        int_part, frac_part = parts[0], parts[1]
    else:
        int_part, frac_part = s, None

    digits = "".join(ch for ch in int_part if ch.isdigit())
    if not digits:
        return str(val).strip()

    formatted_int = "{:,}".format(int(digits)).replace(",", " ")
    if frac_part is not None:
        return f"{formatted_int}{decimal_sep}{frac_part}"
    return formatted_int


def format_mono_amount(val: str) -> str:
    """Форматирует сумму с точкой и двумя знаками после запятой."""
    formatted = format_spaces(val, decimal_sep=".")
    if "." not in formatted:
        return f"{formatted}.00"
    return formatted


def format_tbank_receipt_card(raw_card: str) -> tuple:
    """Возвращает (last4, отформатированную маску '2200 39** **** 7525')."""
    clean = str(raw_card).replace(" ", "")
    digits_only = "".join(ch for ch in clean if ch.isdigit())
    last4 = digits_only[-4:] if len(digits_only) >= 4 else "7525"
    first6 = digits_only[:6] if len(digits_only) >= 6 else "220039"
    spaced_mask = f"{first6[:4]} {first6[4:6]}** **** {last4}"
    return last4, spaced_mask


