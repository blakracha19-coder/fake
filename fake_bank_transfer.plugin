        <div class="tbank-req-val">__TBANK2_REQ__</div>
      </div>
    </div>

    <!-- ЭКРАН 5: ОЗОН БАНК -->
    <div id="ozon-screen" class="__OZON_ACTIVE__">
      <div class="ozon-card-top">
        <div class="ozon-check-wrap">
